{
  "name": "portfolio-ivan",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "format": "eslint . --fix",
    "ts-check": "tsc -b",
    "bump:patch": "bun pm version patch --no-git-tag-version",
